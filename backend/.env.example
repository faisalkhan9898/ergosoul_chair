PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ergosoul
JWT_SECRET=super_secret_ergosoul_key
NODE_ENV=development

# Optional: Cloudinary config (falls back to local uploads if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Real Stripe/Razorpay keys (uses dynamic mocks if omitted)
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
